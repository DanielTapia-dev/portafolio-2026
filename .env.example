# Contact form (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Visitor tracking (PostHog). Public: these are sent to the browser.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# https://us.i.posthog.com or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Admin dashboard: reads analytics from the PostHog Query API. Server only.
POSTHOG_PROJECT_ID=
# Personal API key with the "Query Read" scope, limited to this project.
POSTHOG_PERSONAL_API_KEY=
# Optional: IANA time zone for the dashboard's days (default UTC).
ANALYTICS_TIME_ZONE=America/Guayaquil

# Admin sign-in for /admin. Set real values in Vercel, never in the code.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: 32+ random characters to sign sessions. Without it, sessions are
# signed with the credentials above.
ADMIN_SESSION_SECRET=

# AI avatar (/ask). Every variable here is server only: never prefix with NEXT_PUBLIC_.
# Key from a dedicated Anthropic workspace that has its own monthly spend limit.
ANTHROPIC_API_KEY=
# Upstash Redis (Vercel Marketplace). KV_REST_API_URL and KV_REST_API_TOKEN, which the
# Marketplace integration creates, work too when these two are empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 32+ random characters (openssl rand -hex 32). Signs conversations and hashes IPs.
AVATAR_SIGNING_SECRET=
# Kill switch: anything other than "true" pauses the avatar immediately.
AVATAR_ENABLED=true
# Monthly spend caps in USD: the soft cap limits features, the hard cap stops the avatar.
AVATAR_BUDGET_SOFT_USD=45
AVATAR_BUDGET_HARD_USD=60
# Fixed monthly subscriptions counted against the caps (none in phase 1).
AVATAR_BUDGET_FIXED_USD=0
# Optional limit overrides, shown with their defaults.
# AVATAR_SESSION_QUESTIONS=20
# AVATAR_SESSION_MINUTES=30
# AVATAR_IP_DAILY=40
# AVATAR_IP_PER_MINUTE=6
# AVATAR_GLOBAL_DAILY=500
