# Contact form (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Visitor tracking (PostHog). Public: these are sent to the browser.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# https://us.i.posthog.com or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Admin dashboard: reads analytics from the PostHog Query API. Server only.
POSTHOG_PROJECT_ID=
# Personal API key with the "Query Read" scope, limited to this project.
POSTHOG_PERSONAL_API_KEY=
# Optional: IANA time zone for the dashboard's days (default UTC).
ANALYTICS_TIME_ZONE=America/Guayaquil

# Admin sign-in for /admin. Set real values in Vercel, never in the code.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: 32+ random characters to sign sessions. Without it, sessions are
# signed with the credentials above.
ADMIN_SESSION_SECRET=
